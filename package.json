    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@google/genai": "^2.27.0",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "nanoid": "^6.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
