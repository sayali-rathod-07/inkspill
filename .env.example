# Copy this file to .env and fill in what you need. Never commit .env.

# ---- AI (optional) ----
# Add ONE of these keys (or both) to turn on AI doodles, prompt edits and the polish copilot.
# Without a key InkSpill still works; doodles fall back to a simple auto-layout.

# Free: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Paid: create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# If both keys are set, pick one: gemini or anthropic (default: anthropic)
# AI_PROVIDER=gemini

# AI requests allowed per user per day (the owner is unlimited). Default: 25
# AI_DAILY_LIMIT=25

# ---- Accounts ----
# Username that owns the pre-loaded book. If unset, the first account to sign up becomes the owner.
# INKSPILL_OWNER=

# ---- Storage ----
# Leave empty to store everything as files in ./data (good for local use).
# Set a Postgres connection string to store books, accounts and uploads in the database instead
# (needed on free hosts like Render whose disks are wiped on restart), e.g. a free Neon database.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# PG_POOL_MAX=5
# DATA_DIR=./data

# Max upload size in MB (default: 30 with files, 8 with Postgres)
# UPLOAD_LIMIT_MB=8

PORT=8787
